{
    
"workbench.editor.tabSizing": "shrink",
  "git.ignoreMissingGitWarning": true,
  "editor.glyphMargin": false,
  "editor.wordWrap": "on",
  "editor.snippetSuggestions": "top",
  "editor.fontSize": 16,
  "files.autoSave": "afterDelay",
  "workbench.settings.useSplitJSON": true,
  "workbench.iconTheme": "material-icon-theme",
  "editor.hover.enabled": "onKeyboardModifier",
  "editor.formatOnPaste": true,
  "editor.formatOnSave": true,
  "editor.detectIndentation": false,
  "editor.suggestOnTriggerCharacters": false,
  "window.zoomLevel": 1,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "workbench.list.smoothScrolling": true,
  "editor.smoothScrolling": true,
  "editor.tabSize": 2,
  "workbench.startupEditor": "newUntitledFile",
  "files.defaultLanguage": "html",
  "terminal.integrated.defaultProfile.windows": "Git Bash",
  "terminal.integrated.fontSize": 15,
  "emmet.triggerExpansionOnTab": true,
  "emmet.preferences": { "output.reverseAttributes": true },
  "emmet.syntaxProfiles": { "html": { "inline_break": 1 } },
  "security.workspace.trust.untrustedFiles": "open",
  "security.workspace.trust.enabled": false,
  "editor.lineHeight": 1.8,
  "editor.guides.bracketPairs": "active",
  "editor.matchBrackets": "never",
  "editor.linkedEditing": true,
  "workbench.editor.empty.hint": "hidden",
  "liveServer.settings.donotShowInfoMsg": true,
  "editor.stickyScroll.enabled": false,
  "git.autofetch": true,
  "terminal.integrated.initialHint": false,
  "workbench.colorTheme": "Material Theme Darker High Contrast",
  "gutterpreview.enableReferenceLookup": true,
  "gutterpreview.imagePreviewMaxHeight": 5,
  "gutterpreview.imagePreviewMaxWidth": 5,
  // "ecsstractor_port.bem_nesting": true,
  "ecsstractor_port.add_comment": false,
  "ecsstractor_port.empty_line_before_nested_selector": false,
  "ecsstractor_port.brackets_newline_after": false,
  "ecsstractor_port.indentation": "",
  "breadcrumbs.enabled": false,
  "settingsSync.ignoredExtensions": ["kisstkondoros.vscode-gutter-preview"],
  "prettier.tabWidth": 2,
  "prettier.singleQuote": true,
  "prettier.trailingComma": "all",
  "prettier.semi": false,
  "prettier.bracketSameLine": true,
  "prettier.arrowParens": "avoid",
  "prettier.printWidth": 120,
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "[html]": 
}
